{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Fractch",
  "scopeName": "source.fractch",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.fractch",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.fractch",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.fractch",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.fractch",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.fractch",
              "match": "\\\\[\"\\\\ntr]"
            }
          ]
        },
        {
          "name": "string.template.fractch",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.fractch",
              "match": "\\\\[`\\\\$]"
            },
            {
              "name": "variable.interpolation.fractch",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#comments"
                },
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#keywords"
                },
                {
                  "include": "#operators"
                },
                {
                  "include": "#punctuation"
                }
              ]
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fractch",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.fractch",
          "match": "\\b(when|clone|clicked|broadcast|key|backdrop|any|flag|if|else|for|in|of|using|while|until|repeat|every|seconds|switch|case|fallthrough|default|forever|break|wait|wait_until|stop|all|other_scripts_in_sprite|return)\\b"
        },
        {
          "name": "keyword.declaration.fractch",
          "match": "\\b(def|script|var|cloud|watch|comment|use|from|sprite|stage|size|direction|hidden|visible|draggable|rotation|volume|layer|costume|tempo|video|transparency|tts|at|range|slider|continuous|large|minimized|platform|import|returns|warp|color|file|center|current|list|id)\\b"
        },
        {
          "name": "keyword.other.fractch",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "keyword.other.extension.fractch",
          "match": "\\b(field)\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.fractch",
          "match": "\\blocal\\b"
        },
        {
          "name": "variable.other.global.fractch",
          "match": "\\b(globals|vars|lists|sprites|_stage_)\\b"
        },
        {
          "name": "entity.name.function.def.fractch",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "support.function.builtin.fractch",
          "match": "\\b(say|think|ask|move|turn|turn_left|point|goto|pointTowardsXY|pointTowardsXYFrom|set_x|set_y|change_x|change_y|set_size|change_size|set_effect|change_effect|clear_effects|next_costume|next_backdrop|go_front|go_back|go_forward|go_backward|show|hide|reset_timer|pen_up|pen_down|pen_clear|stamp|clone|delete_clone|broadcast_wait|clear|append|delete|insert|replace|showList|hideList|hasItem|indexOf|item|length|contains|random|round|abs|floor|ceiling|sqrt|sin|cos|tan|asin|acos|atan|ln|log|exp|exp10|not)\\b"
        },
        {
          "name": "support.function.method.fractch",
          "match": "\\b(split|join|count|push)\\b"
        },
        {
          "name": "entity.name.function.fractch",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "variable.other.property.fractch",
          "match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.fractch",
          "match": "(=|\\+=|-=|\\+\\+=)"
        },
        {
          "name": "keyword.operator.arithmetic.fractch",
          "match": "(\\+\\+|\\+|\\-|\\*|\\/|%)"
        },
        {
          "name": "keyword.operator.comparison.fractch",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.fractch",
          "match": "(\\|\\||&&|!)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.fractch",
          "match": ";"
        },
        {
          "name": "punctuation.separator.comma.fractch",
          "match": ","
        },
        {
          "name": "punctuation.separator.colon.fractch",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.fractch",
          "match": "\\."
        }
      ]
    }
  }
}
