{
  "name": "fractch-syntax-highlighting-vscode",
  "version": "1.0.0",
  "description": "A VS Code syntax highlighting extension for the Fractch DSL, by MistWarp.",
  "homepage": "https://github.com/kamixtw/fractch-syntax-highlighting-vscode#readme",
  "bugs": {
    "url": "https://github.com/kamixtw/fractch-syntax-highlighting-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamixtw/fractch-syntax-highlighting-vscode.git"
  },
  "license": "Apache-2.0",
  "author": "Kamix R",
  "displayName": "Fractch Syntax Highlighting",
  "publisher": "kamixtw",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fractch",
        "aliases": [
          "Fractch",
          "fractch"
        ],
        "extensions": [
          ".fractch"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fractch",
        "scopeName": "source.fractch",
        "path": "./syntaxes/fractch.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.0"
  }
}
